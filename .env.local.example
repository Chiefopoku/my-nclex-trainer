# Copy to .env.local and fill in (Supabase -> Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed for scripts/bulk-seed-questions.mjs (never expose in the browser):
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
